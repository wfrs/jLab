NODE_ENV=development

# Database
DATABASE_URL=./jlab.db
DATABASE_TIMEOUT=5000

# API
API_PORT=3000
API_LOG_LEVEL=debug

# Google Drive Integration (Phase 2)
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

# Google Sheets Integration (Phase 2)
GOOGLE_SHEETS_API_KEY=

# GenBank Integration (Phase 2)
GENBANK_EMAIL=
GENBANK_TOOL=jlab

# ICE Integration (Phase 2)
ICE_URL=
ICE_API_KEY=

# Session/Auth (Phase 1)
SESSION_SECRET=local-dev-secret-change-in-production
SESSION_TIMEOUT_MINUTES=480

# Institution string printed in the Formblatt-Z footer (legacy Settings.institution)
JLAB_INSTITUTION=
