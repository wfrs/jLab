# Environment / secrets — .env.example IS committed as the template
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Generated reports (XLSX exports written during manual verification)
Formblatt-Z_*.xlsx
Plasmidlist_*.xlsx

