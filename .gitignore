# Claude Code — machine-local state is ignored, but the shared project
# skills (.claude/skills/) are committed so the team gets the design system
.claude/settings.local.json
.claude/worktrees/
.claude/plans/

# Legacy GMOCU reference app — a clone of https://github.com/beyerh/gmocu.git
# with its own .git directory (git would otherwise flag it as an embedded
# repo) plus ~100 MB of example databases. It is read-only parity ground
# truth; re-clone it into gmocu/ rather than committing it here.
gmocu/
