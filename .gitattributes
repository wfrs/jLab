# Normalize line endings: LF in the repository, native in the working tree.
# Without this, Windows checkouts commit CRLF and every file shows as fully
# rewritten when someone on another platform touches it.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets — never diffed or line-ending converted
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.xlsx binary
*.db binary
*.sqlite binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

# Generated — collapse in diffs and mark as not-authored for language stats
package-lock.json linguist-generated=true -diff
